-- كود إيجاد أقرب وحش
local function getClosestEnemy()
	local closest = nil
	local dist = math.huge
	for _, v in pairs(workspace:GetChildren()) do
		if v:IsA("Model") and v.Name == "Enemy" and v:FindFirstChild("HumanoidRootPart") then
			if v.Humanoid and v.Humanoid.Health > 0 then
				local d = (v.HumanoidRootPart.Position - character.HumanoidRootPart.Position).Magnitude
				if d < dist then
					dist = d
					closest = v
				end
			end
		end
	end
	return closest
end

-- الأوتو فارم (Auto Farm Engine)
task.spawn(function()
	while true do
		task.wait(0.1)
		if isFarming and character and character:FindFirstChild("HumanoidRootPart") then
			local enemy = getClosestEnemy()
			if enemy then
				-- كيطير فوق الوحش بحال السكربتات المحترفة باش ما يضربكش
				character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 6, 0)
				-- يضرب تلقائيا بالسلاح اللي هاز
				local tool = character:FindFirstChildOfClass("Tool")
				if tool then
					tool:Activate()
				end
			end
		end
	end
end)

