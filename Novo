local function New(class,props,parent)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local function Corner(o,r)
    New("UICorner",{CornerRadius=UDim.new(0,r or 10)},o)
end

local function Border(o)
    New("UIStroke",{Color=Purple,Thickness=1.5},o)
end

local function Label(parent,text,pos,size,ts)
    return New("TextLabel",{
        Position=pos,Size=size,
        BackgroundTransparency=1,
        Text=text,TextColor3=White,
        TextSize=ts or 15,
        Font=Enum.Font.GothamBold,
        TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left
    },parent)
end

local function Button(parent,text,pos,size)
    local b=New("TextButton",{
        Position=pos,Size=size,
        BackgroundColor3=Purple,
        Text=text,TextColor3=White,
        TextSize=14,Font=Enum.Font.GothamBold
    },parent)
    Corner(b,9)
    return b
end

